# Lifly 默认开发槽。宿主机端口规范见 scripts/lib/lifly-ports.sh。
LIFLY_DEPLOY_SLOT=dev
# PowerSync 当前仍需完成新版自托管配置迁移，默认不随基础开发环境启动。
LIFLY_ENABLE_POWERSYNC=false

DATABASE_URL=postgresql://lifly:lifly@localhost:8200/lifly
REDIS_URL=redis://localhost:8201/0
MINIO_ENDPOINT=http://localhost:8202
MINIO_ACCESS_KEY=lifly
MINIO_SECRET_KEY=lifly-secret
MINIO_BUCKET=lifly-assets
POWERSYNC_URL=http://localhost:8204
JWT_SECRET=dev-only-change-me
API_PORT=8210

# 当前 local-mcp 使用 stdio，不监听独立 Host Port。
# service_id 02（Dev 8212 / Blue 8242 / Green 8272）仅保留给未来网络 MCP 服务。
